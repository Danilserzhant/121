# --- База ---
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/gamblers_crm?schema=public"

# --- Telegram (MTProto, личный аккаунт) ---
# api_id / api_hash берутся на https://my.telegram.org -> API development tools
TG_API_ID=""
TG_API_HASH=""
# Заполняется автоматически после `npm run tg:login` — это доступ к аккаунту, в git не коммитим
TG_SESSION=""
# @username группы или -100... id. Несколько — через запятую.
TG_CHATS=""

# Хранить ли первые 200 символов сообщений (для выборочного чтения контекста в карточке).
STORE_MESSAGE_PREVIEW="false"
# Сколько дней без сообщений считаем «отвалился»
INACTIVE_DAYS="14"

# --- Docker ---
# Пароль базы внутри docker compose (DATABASE_URL тогда собирается автоматически)
POSTGRES_PASSWORD=""
# Порт, на котором дашборд слушает снаружи
WEB_PORT="3000"
# Пауза между синхронизациями коллектора, секунды
SYNC_INTERVAL="600"
