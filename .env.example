# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAAA...

# Биржа: binance_futures | binance_spot | bybit | okx
EXCHANGE=binance_futures
QUOTE_ASSET=USDT

# Таймфрейм по умолчанию для /top и авторассылки (доступны 1h, 4h, 1d, 1w)
INTERVAL=1h
ATR_PERIOD=14
# Окно сравнения для "расширения" ATR, свечей назад, по таймфреймам
EXPANSION_LOOKBACK=1h:24,4h:6,1d:7,1w:4

# Сколько монет показывать
TOP_N=15
# Отсечь неликвид: минимальный оборот за 24ч в USDT
MIN_QUOTE_VOLUME=5000000
# Минимальный ATR% (средний ход за час), 0 = не фильтровать
MIN_ATR_PCT=0

# Алерт "свеча-выброс": свеча >= N старых ATR и >= M% цены
ALERT_TR_RATIO=2.5
ALERT_MIN_TR_PCT=1.0
# Алерты по своим монетам (/watch): свеча >= N старых ATR или ATR вырос на >= M% к окну
WATCH_TR_RATIO=2.0
WATCH_EXPANSION_PCT=50
# Сколько монет запоминать в истории топов (для колонки "Топ")
HISTORY_TOP=20
# Кэш капитализаций (CoinPaprika / CoinGecko), секунд
MCAP_TTL=1800
# Сколько свечей рисовать на графике
CHART_CANDLES=120

# Telegram ID владельца бота (узнать: /myid). Пусто = владельцем станет первый, кто напишет /start
OWNER_ID=
# Дополнительные админы при старте (id через запятую), необязательно
ADMIN_IDS=

# Параллельных запросов к бирже
CONCURRENCY=8
# Секунд после закрытия свечи перед авто-сканом
CLOSE_DELAY=20
# Кэш результатов /top, секунд
CACHE_TTL=60
# Где хранить пользователей, роли и подписки
STORAGE_PATH=data/store.json
# Прокси для API биржи, если Binance/Bybit заблокированы по гео (напр. http://user:pass@host:port)
EXCHANGE_PROXY=
